# Admin (Payload) qui fournit les contenus — sans / final
CMS_URL=http://localhost:3000
# Identifiant du site dans l'admin
CMS_SITE=tete-dwet
# Adresse publique du site (canonical, hreflang, sitemap) — sans / final
SITE_URL=https://www.tetedwet.com
# Durée de cache des réponses de l'admin, en secondes (délai max avant qu'une publication apparaisse)
CMS_CACHE_SECONDS=60
